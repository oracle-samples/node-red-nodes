[
    {
        "id": "5b7105f00c7c8bff",
        "type": "tab",
        "label": "Device Telemetry and Commands",
        "disabled": false,
        "info": "Configure the MQTT device connection, OCI credentials, notification topic OCID, and digital twin instance OCID before running. Use a non-production device and services. The sample intentionally alerts below 30 degrees: a successful telemetry publish is checked locally, then notification success triggers a shutdown command request. Configure the command endpoint to match the device subscription. The subscriber receives commands, not the published telemetry. Receiving or accepting the request does not demonstrate physical shutdown; the device must implement the command and any response. Change sample temperature to 30 or above to exercise the no-action branch.",
        "env": []
    },
