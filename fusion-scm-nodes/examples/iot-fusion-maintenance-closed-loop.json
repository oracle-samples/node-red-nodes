    {
        "id": "int-loop-function-003",
        "type": "function",
        "z": "int-loop-tab-001",
        "name": "Build maintenance work order",
        "func": "var telemetry = msg.payload || {};\nmsg.payload = {\n    OrganizationCode: telemetry.organizationCode,\n    AssetNumber: telemetry.assetNumber,\n    MntWorkDefinitionCode: telemetry.maintenanceWorkDefinitionCode,\n    WorkOrderTypeCode: \"CORRECTIVE\",\n    WorkOrderSubTypeCode: \"ORA_REACTIVE\",\n    WorkOrderDescription: \"Telemetry fault \" + (telemetry.faultCode || telemetry.status) + \" for \" + telemetry.assetNumber\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1350,
        "y": 400,
        "wires": [
            [
                "int-loop-mwo-001"
            ]
        ]
    },
    {
        "id": "int-loop-mwo-001",
        "type": "maintenance-work-order",
        "z": "int-loop-tab-001",
        "name": "Create maintenance work order",
        "server": "int-loop-scm-config-001",
        "action": "create",
        "workOrderId": "",
        "payloadSource": "mappings",
        "mappings": "[{\"scmField\":\"OrganizationCode\",\"sourceType\":\"msg\",\"value\":\"payload.OrganizationCode\"},{\"scmField\":\"AssetNumber\",\"sourceType\":\"msg\",\"value\":\"payload.AssetNumber\"},{\"scmField\":\"MntWorkDefinitionCode\",\"sourceType\":\"msg\",\"value\":\"payload.MntWorkDefinitionCode\"},{\"scmField\":\"WorkOrderTypeCode\",\"sourceType\":\"msg\",\"value\":\"payload.WorkOrderTypeCode\"},{\"scmField\":\"WorkOrderSubTypeCode\",\"sourceType\":\"msg\",\"value\":\"payload.WorkOrderSubTypeCode\"},{\"scmField\":\"WorkOrderStatusCode\",\"sourceType\":\"static\",\"value\":\"ORA_UNRELEASED\"},{\"scmField\":\"PlannedStartQuantity\",\"sourceType\":\"staticNumber\",\"value\":\"1\"},{\"scmField\":\"PlannedStartDate\",\"sourceType\":\"currentTimestamp\",\"value\":\"\"},{\"scmField\":\"WorkOrderDescription\",\"sourceType\":\"msg\",\"value\":\"payload.WorkOrderDescription\"},{\"scmField\":\"ExplosionFlag\",\"sourceType\":\"staticBoolean\",\"value\":\"true\"}]",
