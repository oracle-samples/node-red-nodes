        "requiredFields": "[]",
        "splitFields": "[]",
        "samplePayload": "{\"deviceId\":\"EXAMPLE_ROBOT_01\",\"assetNumber\":\"EXAMPLE_ASSET_01\",\"eventTime\":\"2026-08-12T12:00:00Z\",\"status\":\"IN_USE\"}",
        "customJsonata": "",
        "staleTimeout": 0,
