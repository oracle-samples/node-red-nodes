[
    {
        "id": "int-loop-tab-001",
        "type": "tab",
        "label": "Sample Device Fault Handling",
        "disabled": false,
        "info": "Configure the placeholder OCI and Fusion nodes before running. Clicking Run sample device fault submits CA_STATUS and CA_FAULT Smart Operations events, invokes an OCI IoT shutdown command, and creates a Fusion maintenance work order. Missing device/asset/organization/work-definition values or invalid temperatures are reported before any service call."
    },
    {
        "id": "int-loop-comment-001",
        "type": "comment",
        "z": "int-loop-tab-001",
        "name": "Configure services and business values before running — double-click for setup details",
        "info": "Before running:\n\n1. Configure Example OCI Config with permission to invoke commands.\n2. Configure Example Fusion SCM with OAuth credentials and Smart Operations/Maintenance privileges.\n3. Replace the digital twin instance OCID in Send shutdown command.\n4. Replace the EXAMPLE_* asset and organization values in the Inject payload.\n5. Replace <your-maintenance-work-definition-code> with the Code from Fusion Maintenance Work Definitions for the selected organization. This is not the organization code, the CORRECTIVE work-order type, or an assumed ORA_* value.\n6. Confirm the request and response command topics.\n\nClicking Run sample device fault sends real OCI and Fusion requests. Use non-production resources for the first run.",
        "x": 350,
        "y": 60,
        "wires": []
    },
    {
        "id": "int-loop-inject-001",
        "type": "inject",
        "z": "int-loop-tab-001",
        "name": "Run sample device fault",
        "props": [
            {
                "p": "payload",
                "v": "{\"deviceId\":\"EXAMPLE_ROBOT_01\",\"assetNumber\":\"EXAMPLE_ASSET_01\",\"organizationCode\":\"EXAMPLE_ORG\",\"maintenanceWorkDefinitionCode\":\"<your-maintenance-work-definition-code>\",\"status\":\"FAULT\",\"temperature\":42.7,\"faultCode\":\"EXAMPLE_OVER_TEMP\"}",
                "vt": "json"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "x": 200,
        "y": 150,
        "wires": [
            [
                "int-loop-function-001"
            ]
        ]
    },
    {
        "id": "int-loop-function-001",
        "type": "function",
        "z": "int-loop-tab-001",
        "name": "Normalize telemetry",
        "func": "var input = msg.payload;\nvar required = [\"deviceId\", \"assetNumber\", \"organizationCode\", \"maintenanceWorkDefinitionCode\"];\nvar valid = input && typeof input === \"object\" && !Array.isArray(input);\nif (valid) {\n    valid = required.every(function (key) {\n        return typeof input[key] === \"string\" && input[key].trim() !== \"\";\n    });\n}\nvar temperature = valid && (typeof input.temperature === \"number\" ||\n    (typeof input.temperature === \"string\" && input.temperature.trim() !== \"\"))\n    ? Number(input.temperature) : NaN;\nif (!valid || !Number.isFinite(temperature)) {\n    var error = new Error(\"Provide device, asset, organization, maintenance work definition, and a numeric temperature\");\n    error.code = \"EXAMPLE_INVALID_TELEMETRY\";\n    msg.error = { message: error.message, code: error.code };\n    node.done(error);\n    return null;\n}\nmsg.payload = {\n    deviceId: input.deviceId,\n    assetNumber: input.assetNumber,\n    organizationCode: input.organizationCode,\n    maintenanceWorkDefinitionCode: input.maintenanceWorkDefinitionCode,\n    eventTime: input.eventTime || new Date().toISOString(),\n    status: String(input.status || \"UNKNOWN\").toUpperCase(),\n    temperature: temperature,\n    faultCode: input.faultCode || \"\"\n};\nnode.done();\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 480,
        "y": 150,
        "wires": [
            [
                "int-loop-debug-001",
                "int-loop-transform-001",
                "int-loop-switch-002"
            ]
        ]
    },
    {
        "id": "int-loop-debug-001",
        "type": "debug",
        "z": "int-loop-tab-001",
        "name": "Normalized telemetry",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": false,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "",
        "statusType": "auto",
        "x": 740,
        "y": 70,
        "wires": []
    },
    {
