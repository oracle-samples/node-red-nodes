    {
        "id": "int-loop-function-002",
        "type": "function",
        "z": "int-loop-tab-001",
        "name": "Build shutdown command",
        "func": "var telemetry = msg.payload || {};\nmsg.payload = {\n    command: \"shutdown\",\n    assetNumber: telemetry.assetNumber,\n    reason: telemetry.faultCode || telemetry.status,\n    requestedAt: new Date().toISOString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1330,
        "y": 240,
        "wires": [
            [
                "int-loop-command-001"
            ]
        ]
    },
    {
        "id": "int-loop-command-001",
        "type": "iot-send-command",
        "z": "int-loop-tab-001",
        "name": "Send shutdown command",
        "ociConfig": "int-loop-oci-config-001",
        "digitalTwinOcid": "<your-digital-twin-identifier>",
        "requestEndpoint": "iot/v1/devices/example/cmd/shutdown",
        "responseEndpoint": "iot/v1/devices/example/rsp/shutdown",
        "requestDuration": "PT10M",
        "responseDuration": "PT10M",
        "waitForResponse": true,
        "x": 1610,
        "y": 240,
        "wires": [
            [
                "int-loop-debug-006"
            ]
        ]
    },
