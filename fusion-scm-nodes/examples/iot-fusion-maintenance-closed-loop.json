        "eventTypeCode": "CA_STATUS",
        "selectedPreset": "CA_STATUS",
        "customEventType": "",
        "entityCodeFields": "[\"assetNumber\",\"deviceId\"]",
        "eventTimeFields": "[\"eventTime\"]",
