    {
        "id": "meter-example-confirm-absent",
        "type": "function",
        "z": "4e260a9ffc513bbc",
        "name": "Confirm asset is absent",
        "func": "var result = msg.payload;\nvar failure = msg.meterReadingFailure;\nif (msg.statusCode === 200 && result && Array.isArray(result.items) &&\n    result.items.length === 0 && result.hasMore === false) {\n    delete msg.error;\n    delete msg._error;\n    delete msg.method;\n    msg.payload = msg.dequeued;\n    return [msg, null];\n}\nmsg.error = failure ? failure.error : {\n    message: \"Asset absence could not be confirmed\",\n    code: null\n};\nmsg.statusCode = failure ? failure.statusCode : msg.statusCode;\nmsg.payload = failure ? failure.payload : msg.payload;\nreturn [null, msg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
