    {
        "id": "meter-example-recovery-gate",
        "type": "function",
        "z": "4e260a9ffc513bbc",
        "name": "Check meter recovery error",
        "func": "var source = msg.error && msg.error.source;\nvar expected = \"The value of the attribute AssetNumber isn't valid.\";\nif (!source || source.id !== \"2fbc8e32c898d5b4\" ||\n    msg.statusCode !== 400 || typeof msg.payload !== \"string\" ||\n    msg.payload.trim() !== expected) {\n    return [null, msg];\n}\nvar asset = msg.dequeued && msg.dequeued.AssetNumber;\nif (typeof msg._msgid !== \"string\" || !msg._msgid ||\n    typeof asset !== \"string\" || !asset.trim() || /[;'\\\\\\r\\n]/.test(asset)) {\n    return [null, msg];\n}\n// The runtime can report the same failure through both node.error and done.\nvar now = Date.now();\nvar recent = (context.get(\"recentFailures\") || []).filter(function (entry) {\n    return now - entry.time < 600000;\n});\nvar key = msg._msgid;\nif (recent.some(function (entry) { return entry.key === key; })) {\n    return null;\n}\nif (recent.length >= 1000) {\n    return [null, msg];\n}\nrecent.push({ key: key, time: now });\ncontext.set(\"recentFailures\", recent);\nmsg.meterReadingFailure = {\n    error: msg.error,\n    statusCode: msg.statusCode,\n    payload: msg.payload\n};\ndelete msg.error;\ndelete msg._error;\nmsg.payload = {\n    q: \"AssetNumber='\" + asset + \"'\",\n    fields: \"AssetNumber\",\n    onlyData: true,\n    limit: 1\n};\nmsg.method = \"GET\";\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 400,
        "wires": [
